# Azure AD B2C Configuration
REACT_APP_B2C_TENANT_NAME=nztaxcopilot
REACT_APP_B2C_CLIENT_ID=<from-stage4-outputs>
REACT_APP_B2C_POLICY_NAME=B2C_1_signup_signin
REACT_APP_B2C_AUTHORITY=https://nztaxcopilot.b2clogin.com/nztaxcopilot.onmicrosoft.com/B2C_1_signup_signin

# Backend API URL
